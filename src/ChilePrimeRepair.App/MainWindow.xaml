<Window x:Class="ChilePrimeRepair.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Asistente de Chile Prime" Width="580" Height="550" MinWidth="400" MinHeight="320"
 Background="{StaticResource BgBase}" FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResize"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
 TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled">
 <Window.Icon><DrawingImage><DrawingImage.Drawing><GeometryDrawing Brush="#3B82F6" Geometry="M0,0 L32,0 32,32 0,32Z M9,9 L9,23 23,23 23,18 14,18 14,9Z"/></DrawingImage.Drawing></DrawingImage></Window.Icon>
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="WindowButton" TargetType="Button">
   <Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource BgElevated}"/><Setter Property="Foreground" Value="White"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Close"/></MultiTrigger.Conditions>
      <Setter TargetName="Frame" Property="Background" Value="#B91C1C"/>
     </MultiTrigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource BgHover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Frame" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="PrimeLogo">
   <Grid Width="260" Height="114" AutomationProperties.Name="Chile Prime">
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0" Background="{StaticResource Accent}">
     <Border.RenderTransform><RotateTransform Angle="45" CenterX="5" CenterY="5"/></Border.RenderTransform>
    </Border>
    <TextBlock Text="CHILE" FontSize="62" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F4F8FF" Offset="0"/><GradientStop Color="#C9D8F4" Offset="0.4"/><GradientStop Color="#6693DC" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
    </TextBlock>
    <TextBlock Grid.Row="1" Text="P R I M E" FontSize="23" FontWeight="SemiBold" Foreground="#CDDCF5" HorizontalAlignment="Center" VerticalAlignment="Top"/>
   </Grid>
  </DataTemplate>
  <!-- Render smaller marks with their actual font sizes instead of scaling a large text visual. -->
  <DataTemplate x:Key="PrimeLogoProgress">
   <Grid Width="220" Height="100" AutomationProperties.Name="Chile Prime">
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" Background="{StaticResource Accent}">
     <Border.RenderTransform><RotateTransform Angle="45" CenterX="4" CenterY="4"/></Border.RenderTransform>
    </Border>
    <TextBlock Text="CHILE" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F4F8FF" Offset="0"/><GradientStop Color="#C9D8F4" Offset="0.4"/><GradientStop Color="#6693DC" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
    </TextBlock>
    <TextBlock Grid.Row="1" Text="P R I M E" FontSize="20" FontWeight="SemiBold" Foreground="#CDDCF5" HorizontalAlignment="Center" VerticalAlignment="Top"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="PrimeLogoResult">
   <Grid Width="200" Height="90" AutomationProperties.Name="Chile Prime">
    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,9,0,0" Background="{StaticResource Accent}">
     <Border.RenderTransform><RotateTransform Angle="45" CenterX="4" CenterY="4"/></Border.RenderTransform>
    </Border>
    <TextBlock Text="CHILE" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F4F8FF" Offset="0"/><GradientStop Color="#C9D8F4" Offset="0.4"/><GradientStop Color="#6693DC" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
    </TextBlock>
    <TextBlock Grid.Row="1" Text="P R I M E" FontSize="18" FontWeight="SemiBold" Foreground="#CDDCF5" HorizontalAlignment="Center" VerticalAlignment="Top"/>
   </Grid>
  </DataTemplate>
  <Style x:Key="CenteredText" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
   <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
   <Setter Property="TextAlignment" Value="Center"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </Window.Resources>
 <Grid Background="{StaticResource BgBase}">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="{StaticResource BgBase}" AutomationProperties.Name="Arrastra para mover la ventana">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="MinimizeButton" Click="MinimizeClick" Style="{StaticResource WindowButton}" ToolTip="Minimizar" AutomationProperties.Name="Minimizar ventana">
     <Path Data="M0,5 L10,5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
    </Button>
    <Button x:Name="MaximizeButton" Click="MaximizeClick" Style="{StaticResource WindowButton}" ToolTip="Maximizar" AutomationProperties.Name="Maximizar o restaurar ventana">
     <Grid Width="10" Height="10">
      <Path x:Name="MaximizeIcon" Data="M0.5,0.5 L9.5,0.5 9.5,9.5 0.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
      <Path x:Name="RestoreIcon" Data="M2.5,2.5 L9.5,2.5 9.5,9.5 2.5,9.5 Z M0.5,7.5 L0.5,0.5 7.5,0.5 7.5,2.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed"/>
     </Grid>
    </Button>
    <Button x:Name="CloseButton" Click="CloseClick" Tag="Close" Style="{StaticResource WindowButton}" ToolTip="Cerrar" AutomationProperties.Name="Cerrar asistente">
     <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
    </Button>
   </StackPanel>
  </Grid>
 <ScrollViewer x:Name="AssistantScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource BgBase}">
  <Grid x:Name="Surface" MinHeight="440" Margin="32,24">
   <Grid x:Name="WelcomeView">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12">
     <ContentControl ContentTemplate="{StaticResource PrimeLogo}" Margin="0,0,0,50"/>
     <Button x:Name="StartButton" Click="StartClick" Content="Comenzar" Style="{StaticResource PrimaryButton}" Width="206" Padding="20,15" FontSize="14" AutomationProperties.Name="Comenzar reparación automática"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="ProgressView" Visibility="Collapsed">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="350">
     <ContentControl ContentTemplate="{StaticResource PrimeLogoProgress}" HorizontalAlignment="Center" Margin="0,0,0,38"/>
     <Path x:Name="ActivitySpinner" Width="16" Height="16" Data="M8,1 A7,7 0 1 1 1,8" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Margin="0,0,0,14" RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
      <Path.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger></Path.Triggers>
     </Path>
     <TextBlock x:Name="StageLabel" Text="Preparando tu cliente…" Style="{StaticResource CenteredText}" FontSize="16" FontWeight="SemiBold" MinHeight="42"/>
     <ProgressBar x:Name="Progress" Height="7" Margin="8,16,8,0" Minimum="0" Maximum="100" Value="0">
      <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
       <Grid><Border Background="{StaticResource BgElevated}" CornerRadius="3.5"/>
        <Border x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource PrimaryGradient}" CornerRadius="3.5"/></Border>
       </Grid>
      </ControlTemplate></ProgressBar.Template>
     </ProgressBar>
     <TextBlock x:Name="PercentLabel" Text="0%" Style="{StaticResource CenteredText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/>
     <TextBlock x:Name="ProgressHint" Text="" Style="{StaticResource CenteredText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,13,0,0" Visibility="Collapsed"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="OutcomeView" Visibility="Collapsed">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="350">
     <ContentControl ContentTemplate="{StaticResource PrimeLogoResult}" HorizontalAlignment="Center" Margin="0,0,0,30"/>
     <Border x:Name="ResultIcon" Width="36" Height="36" Background="#142A1C" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,14">
      <TextBlock x:Name="ResultMark" Text="✓" FontFamily="Segoe UI" Foreground="{StaticResource Success}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock x:Name="ResultTitle" Text="Reparación completada" Style="{StaticResource CenteredText}" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock x:Name="ResultMessage" Text="Ya puedes abrir FiveM y volver a Chile Prime." Style="{StaticResource CenteredText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
     <Expander x:Name="DiagnosisDetails" Header="Ver diagnóstico y recomendaciones" Visibility="Collapsed" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,16,0,0">
      <StackPanel>
       <TextBlock x:Name="DiagnosisText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
       <Button x:Name="CopyDiagnosisButton" Content="Copiar informe para soporte" Click="CopyDiagnosisClick" Background="Transparent" Foreground="{StaticResource Muted}" Padding="10,7" Margin="0,10,0,0"/>
      </StackPanel>
     </Expander>
     <Button x:Name="GraphicsButton" Content="Abrir opciones de gráficos de Windows" Click="GraphicsClick" Visibility="Collapsed" Background="Transparent" Foreground="{StaticResource Muted}" FontSize="10" Padding="10,7" Margin="0,9,0,0"/>
     <Button x:Name="FinishButton" Content="Finalizar" Click="FinishClick" Style="{StaticResource PrimaryButton}" Width="206" Padding="20,13" FontSize="13" HorizontalAlignment="Center" Margin="0,25,0,0"/>
     <Button x:Name="RestoreButton" Content="Deshacer los ajustes" Click="RestoreClick" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Normal" Padding="10,7" HorizontalAlignment="Center" Margin="0,9,0,0" ToolTip="Recupera las preferencias anteriores. La caché se regenera al usar FiveM."/>
    </StackPanel>
   </Grid>
  </Grid>
 </ScrollViewer>
 </Grid>
</Window>
